# Host402 Server Configuration
PORT=4020
MCP_PORT=4021
BASE_URL=http://localhost:4020

# Blockchain Network & Token Configuration
# Base Mainnet: eip155:8453 (USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913)
# Base Sepolia: eip155:84532 (USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e)
X402_NETWORK=eip155:84532
X402_PAY_TO=0x567E4CdDe14FC5D6207B0fA7750b13C7223acF6A
X402_FACILITATOR_URL=https://x402.org/facilitator

# Pricing (in USDC atomic units, 6 decimals)
# 20000 = $0.02 USDC
# 50000 = $0.05 USDC
# 10000 = $0.01 USDC
PRICE_STATIC_USDC=20000
PRICE_API_USDC=50000
PRICE_RENEW_USDC=10000

# Storage & Database
STORAGE_DIR=./storage/deployments
DB_PATH=./storage/host402.json

# Development mode (enables test/simulated payment signatures)
ALLOW_DEV_BYPASS=true
NODE_ENV=development
